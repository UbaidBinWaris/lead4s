generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobApplication {
  id          Int      @id @default(autoincrement())
  fullName    String   @map("full_name")
  email       String
  phone       String?
  position    String
  resumePath  String   @map("resume_path")
  coverLetter String   @map("cover_letter")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("job_applications")
}

model CaseStudy {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  industry     String
  summary      String
  challenge    String
  solution     String
  results      Json     // [{ label: string, value: string }]
  content      Json     @default("[]") // IndustrySection[]
  coverImage   String?
  isPublished  Boolean  @default(true) @map("is_published")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("case_studies")
}

model Blog {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  excerpt         String
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  content         String   // markdown content
  coverImage      String?  @map("cover_image")
  author          String   @default("Lead4s Editorial Team")
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("blogs")
}

model Page {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  content         Json     @default("[]")
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model Industry {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  type            String   @default("industry") // "industry" | "solution"
  description     String?
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  cardColor       String?  @map("card_color")
  cardTags        Json?    @map("card_tags")
  cardMetricValue String?  @map("card_metric_value")
  cardMetricLabel String?  @map("card_metric_label")
  cardBenefit     String?  @map("card_benefit")
  content         Json     // structured sections array
  coverImage      String?  @map("cover_image")
  isPublished     Boolean  @default(true) @map("is_published")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("industries")
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  bio       String
  initials  String
  gradient  String
  linkedin  String?
  twitter   String?
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([position])
  @@map("team_members")
}

model MediaImage {
  id          String   @id @default(uuid())
  path        String   @unique // public path, e.g. /wp-content/uploads/2024/01/image.jpg
  altText     String?  @map("alt_text")
  mimeType    String?  @map("mime_type")
  fileSize    Int?     @map("file_size") // bytes
  width       Int?
  height      Int?
  originUrl   String?  @map("origin_url") // original https://lead4s.com/... URL
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("media_images")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String   @default("footer")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

model PartnershipApplication {
  id          String   @id @default(uuid())
  companyName String   @map("company_name")
  contactName String   @map("contact_name")
  email       String
  phone       String?
  website     String?
  vertical    String   // solar, roofing, hvac, etc.
  monthlyVolume String? @map("monthly_volume")
  message     String?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("partnership_applications")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model BuyerLead {
  id                               String   @id @default(uuid())
  trackdriveNumber                 String   @map("trackdrive_number")
  trafficSourceId                  String   @map("traffic_source_id")
  callerId                         String   @map("caller_id")
  pingId                           String?  @map("ping_id")
  s1                               String?
  s2                               String?
  s3                               String?
  s4                               String?
  s5                               String?
  subId                            String?  @map("sub_id")
  trafficSourceLeadId              String?  @map("traffic_source_lead_id")
  maritalStatus                    String?  @map("marital_status")
  weight                           Int?
  gclid                            String?
  agedData                         Boolean? @map("aged_data")
  originalLeadSubmitDate           DateTime? @map("original_lead_submit_date")
  email                            String?
  trafficSourceAgentId             String?  @map("traffic_source_agent_id")
  trafficSourceAgentRecordingUrl   String?  @map("traffic_source_agent_recording_url")
  smoker                           Boolean?
  nicotineFrequency                String?  @map("nicotine_frequency")
  monthsInsuredContinuously        String?  @map("months_insured_continuously")
  lastName                         String?  @map("last_name")
  address                          String?
  address2                         String?
  city                             String?
  zip                              String?
  dobYyyy                          Int?     @map("dob_yyyy")
  spokenLanguage                   String?  @map("spoken_language")
  bestTimeToContact                String?  @map("best_time_to_contact")
  tcpaOptinConsentLanguage         String?  @map("tcpa_optin_consent_language")
  trafficSourceDataListId          String?  @map("traffic_source_data_list_id")
  dobDd                            Int?     @map("dob_dd")
  gender                           String?
  jornayaLeadid                    String?  @map("jornaya_leadid")
  trustedFormCertUrl               String?  @map("trusted_form_cert_url")
  paymentMethodAvailable           Boolean? @map("payment_method_available")
  trustedFormCertUrlAgent          String?  @map("trusted_form_cert_url_agent")
  trafficSourcePlatform            String?  @map("traffic_source_platform")
  jornayaLeadIdAgent               String?  @map("jornaya_lead_id_agent")
  monthlyAffordablePaymentAmount   Int?     @map("monthly_affordable_payment_amount")
  eaDisposition                    String?  @map("ea_disposition")
  userAgent                        String?  @map("user_agent")
  employmentStatus                 String?  @map("employment_status")
  insuranceAmountRequested         String?  @map("insurance_amount_requested")
  currentlyInsured                 Boolean? @map("currently_insured")
  expirationDate                   String?  @map("expiration_date")
  msclkid                          String?
  childrenAges                     String?  @map("children_ages")
  heightInInches                   Int?     @map("height_in_inches")
  annualIncome                     Int?     @map("annual_income")
  insuranceCompany                 String?  @map("insurance_company")
  dob                              String?  @map("dob")
  mediaType                        String?  @map("media_type")
  blueinkSecuredLeadsToken         String?  @map("blueink_secured_leads_token")
  desiredPolicyType                String?  @map("desired_policy_type")
  leadType                         String?  @map("lead_type")
  ipAddress                        String?  @map("ip_address")
  sourceUrl                        String?  @map("source_url")
  yearsInsured                     Int?     @map("years_insured")
  permissiontrustToken             String?  @map("permissiontrust_token")
  smokeOption                      String?  @map("smoke_option")
  monthsInsured                    Int?     @map("months_insured")
  yearsInsuredContinuously         Int?     @map("years_insured_continuously")
  trafficSourceAgentName           String?  @map("traffic_source_agent_name")
  children                         Int?
  medicalConditions                String?  @map("medical_conditions")
  coverageType                     String?  @map("coverage_type")
  state                            String?
  firstName                        String?  @map("first_name")
  dobMm                            Int?     @map("dob_mm")
  alternatePhone                   String?  @map("alternate_phone")
  tcpaOptIn                        Boolean? @map("tcpa_opt_in")
  voluumCid                        String?  @map("voluum_cid")
  fbeventid                        String?  @map("fbeventid")
  retreaverCallKey                 String?  @map("retreaver_call_key")
  retreaverCallUuid                String?  @map("retreaver_call_uuid")
  ringbaCallUuid                   String?  @map("ringba_call_uuid")

  // Request & API Logs
  status                           String   @default("pending") // pending, ping_success, ping_failed, post_success, post_failed
  pingResponse                     Json?    @map("ping_response")
  postResponse                     Json?    @map("post_response")

  createdAt                        DateTime @default(now()) @map("created_at")
  updatedAt                        DateTime @updatedAt @map("updated_at")

  @@map("buyer_leads")
}

